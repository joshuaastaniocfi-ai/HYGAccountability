{
  "name": "chawnah-equipment-accountability",
  "version": "1.0.0",
  "description": "Equipment Accountability & Asset Tracking System for Chawnah Foods Inc.",
  "scripts": {
    "build": "cd client && npm install && npm run build",
    "start": "node server/server.js",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "install:all": "npm install && npm run install:server && npm run install:client",
    "seed": "cd server && npm run seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.1",
    "morgan": "^1.10.0",
    "pngjs": "^7.0.0"
  },
  "keywords": [
    "mern",
    "asset-tracking",
    "equipment-accountability",
    "inventory",
    "employees"
  ],
  "author": "Chawnah Foods Inc.",
  "license": "ISC"
}

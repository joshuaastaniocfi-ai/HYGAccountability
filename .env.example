# Environment Variables for Vercel & Production
# Configure these under Project Settings -> Environment Variables in the Vercel Dashboard

# MongoDB Connection String (from MongoDB Atlas)
# Example: mongodb+srv://dbuser:StrongPassword123@cluster0.abcde.mongodb.net/chawnah_accountability?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/chawnah_accountability?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=chawnah_foods_inc_asset_secret_key_2026

# Node Environment
NODE_ENV=production

# Server Port (optional on local, auto-handled by Vercel)
PORT=5000

